# =============================================================================
# CN: StreamPump backend environment example.
# EN: StreamPump backend environment example.
# =============================================================================

# =============================================================================
# P0 / Must Have Now / 现在就必须提供
# =============================================================================

NODE_ENV=development
PORT=4000

# API_BASE_URL / 后端 API 对外基准地址
# CN: 用于生成内部 canonical URL，默认应包含 /api/v1。
# EN: Used to build internal canonical URLs; should usually include /api/v1.
API_BASE_URL=http://localhost:4000/api/v1

# CORS_ALLOWED_ORIGINS / 允许访问后端的前端来源
# CN: 生产环境请显式填写前端域名列表，逗号分隔，不要带路径。
# EN: Comma-separated frontend origins allowed to call the backend API. Use origins only, without paths.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004

# AUTH_* / 钱包认证会话
# CN: challenge/signature 登录使用的会话签名密钥和有效期；生产环境务必替换默认值。
# EN: Session-signing secret and TTLs for challenge/signature login. Replace the default secret in production.
AUTH_SESSION_SECRET=dev-only-session-secret-change-me
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=604800
# CN: 仅用于本地迁移或兼容旧脚本；生产环境请保持 false。
# EN: Local migration fallback for legacy x-wallet-address callers; keep false in production.
AUTH_ALLOW_LEGACY_WALLET_HEADER=false
# CN: 仅本地/录屏 demo 可设 true；生产/公开预览必须保持 false，避免客户端伪造社交身份。
# EN: Set true only for local/video demos; keep false in production/public previews to avoid client-forged social identities.
AUTH_ALLOW_PREVIEW_PROVIDER_EXCHANGE=false

# MANAGED_WALLET_ENCRYPTION_KEY / 托管钱包密钥加密主密钥
# CN: 生产环境必填，必须是 64 位 hex（32 bytes）。用 `openssl rand -hex 32` 生成后放入 Render/secret manager，不能提交真实值。
# EN: Required in production. Must be 64 hex chars (32 bytes). Generate with `openssl rand -hex 32` and store it in Render/a secret manager; never commit the real value.
MANAGED_WALLET_ENCRYPTION_KEY=

# EMAIL_* / 邮箱验证码登录
# CN: 本地可用 console 模式在 backend 日志查看验证码；生产建议使用 resend。
# EN: Use console mode locally to read OTP codes from backend logs; use resend in production.
EMAIL_DELIVERY_MODE=console
EMAIL_FROM=StreamPump <login@streampump.local>
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_CODE_LENGTH=6
# EMAIL_OTP_DEV_CODE=123456
# RESEND_API_KEY=

# DATABASE_URL / 运行时数据库连接串（推荐 Neon pooler）
# CN: 后端运行时建议使用 Neon pooled connection，主机名通常带 `-pooler`。
# EN: Runtime backend connection string. Prefer a Neon pooled connection whose hostname usually includes `-pooler`.
DATABASE_URL=postgresql://app_user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/streampump?sslmode=require&channel_binding=require

# DIRECT_URL / Prisma migration 直连串
# CN: Prisma migrate / introspection 应走直连，不要走 pooler，否则容易触发 PgBouncer 兼容问题。
# EN: Prisma migrate / introspection should use a direct connection instead of the pooler to avoid PgBouncer compatibility issues.
DIRECT_URL=postgresql://app_user:password@ep-example.ap-southeast-1.aws.neon.tech/streampump?sslmode=require&channel_binding=require

# SOLANA_RPC_ENDPOINT / Solana RPC 地址
# CN: 后端查询链上 proposal、发送 oracle 结算交易都依赖它。
# EN: Used for proposal reads and oracle settlement transactions.
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

# STREAMPUMP_PROGRAM_ID / 协议程序 ID
# CN: 后端推导 PDA 和调用 Anchor 方法时使用的程序地址。
# EN: Program address used by the backend for PDA derivation and Anchor calls.
STREAMPUMP_PROGRAM_ID=EV2frDqtvTfmshXxsNipDSEANWeZxzHEazzDu51rDzre

# STREAMPUMP_IDL_PATH / 协议 IDL 路径
# CN: 如不填，后端会尝试自动读取 target/idl/streampump_core.json。
# EN: Optional explicit IDL path. If omitted, the backend will try target/idl/streampump_core.json.
STREAMPUMP_IDL_PATH=../target/idl/streampump_core.json

# CN: 如果你本地不用 Neon，也可以临时切回本地 Postgres，把上面的两项都改成本地连接。
# EN: If you are not using Neon locally, you can temporarily point both variables above to a local Postgres instance.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streampump_backend?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/streampump_backend?schema=public

# ORACLE_AUTHORITY_KEYPAIR_PATH / Oracle 权限密钥文件路径
# CN: 后端代执行链上结算时使用。推荐生产环境用密钥管理，不要和 SECRET_KEY 同时填写。
# EN: Used for backend-driven on-chain settlements. Prefer secret managers in production; do not set together with SECRET_KEY.
ORACLE_AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json
# ORACLE_AUTHORITY_SECRET_KEY=[12,34,56,...]

# R2_* / 原始素材对象存储
# CN: 当前生产对象存储方案是 Cloudflare R2。后端使用 R2 API 生成 presigned URL。
# EN: The current origin object store is Cloudflare R2. The backend uses R2 API for presigned URLs.
R2_REGION=auto
R2_BUCKET=streampump-origin
# CN: R2 endpoint 通常形如 https://<account_id>.r2.cloudflarestorage.com。
# EN: R2 endpoint usually looks like https://<account_id>.r2.cloudflarestorage.com.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL / 对外访问基准地址
# CN: 用于生成素材的公开/回源 URL。
# EN: Base URL used to build public/origin asset URLs.
R2_PUBLIC_BASE_URL=
# R2_MAX_ASSET_SIZE_BYTES / 单个素材最大体积
# CN: 默认 100MiB，避免误传大文件直接推高 R2 存储与请求量。
# EN: Default 100MiB to prevent accidental large uploads from driving R2 storage and request usage.
R2_MAX_ASSET_SIZE_BYTES=104857600
# R2_MONTHLY_UPLOAD_LIMIT_BYTES / 后端月度上传预算硬限制
# CN: 设置为 10GiB 可贴近 R2 Standard 免费存储量；设为 0 表示不启用后端硬限制。
# EN: Set to 10GiB to stay close to R2 Standard included storage; set 0 to disable the backend hard limit.
R2_MONTHLY_UPLOAD_LIMIT_BYTES=10737418240
# R2_PUBLIC_FEED_USE_SIGNED_URLS / 公共 feed 临时改用签名读取 URL
# CN: 仅当 R2 自定义域公开读取权限尚未修好、公开素材返回 403 时临时设为 true。
# EN: Temporarily set true only when public R2 custom-domain reads are returning 403 and the feed needs signed read URLs.
R2_PUBLIC_FEED_USE_SIGNED_URLS=false

# =============================================================================
# P1 / Strongly Recommended Soon / 近期强烈建议补齐
# =============================================================================

# MUX_* / 视频转码与播放
# CN: 视频素材 complete 之后会进入 Mux 转码流程，Webhook 用于回写 processing 状态。
# EN: Video assets enter the Mux processing pipeline after upload completion; the webhook updates processing state.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_REQUEST_TIMEOUT_MS=20000
MUX_RECONCILIATION_ENABLED=false
MUX_RECONCILIATION_RUN_ON_BOOT=false
MUX_RECONCILIATION_CRON=*/10 * * * *
MUX_RECONCILIATION_BATCH_SIZE=50
MUX_RECONCILIATION_STALE_MINUTES=5
MUX_RECONCILIATION_MAX_ATTEMPTS=24

# ORACLE_* / 定时结算与 RPC 容错
# CN: 控制 Track1/2/3 定时任务、启动行为和每批处理规模。
# EN: Controls Track1/2/3 cron jobs, boot behavior, and per-batch processing size.
ORACLE_SCHEDULER_ENABLED=false
ORACLE_RUN_ON_BOOT=false
ORACLE_TRACK3_AUTO_SETTLEMENT_ENABLED=false
ORACLE_TRACK1_CRON=0 * * * *
ORACLE_TRACK2_CRON=15 2 * * *
ORACLE_TRACK3_CRON=45 2 * * *
ORACLE_WORKER_BATCH_SIZE=200
ORACLE_RPC_TIMEOUT_MS=25000

# INDEXER_* / 链上日志索引
# CN: 控制 Phase A 链上日志订阅、重启时的轻量 backfill 和游标命名。
# EN: Controls the Phase A on-chain log subscription, lightweight restart backfill, and cursor naming.
INDEXER_ENABLED=false
INDEXER_BACKFILL_LIMIT=100
INDEXER_CONSUMER_KEY=streampump_core_logs

# ANTICHEAT_* / 轻量风控参数
# CN: 当前原型使用内存级风控和去重，这些参数影响风险评分阈值。
# EN: The prototype uses in-memory fraud checks and dedupe; these values tune risk scoring.
ANTICHEAT_MAX_RISK_SCORE=45
ANTICHEAT_IP_WINDOW_MS=300000
ANTICHEAT_MIN_INTERACTIONS=3

# CONTENT_ANCHOR_SIGNER_* / 服务端内容锚定签名者
# CN: 仅当你希望后端代签 anchor_content_hash 时使用；否则保持为空并走前端签名。
# EN: Only needed if the backend should server-sign anchor_content_hash; otherwise keep empty and use client-side signing.
CONTENT_ANCHOR_SIGNER_KEYPAIR_PATH=
# CONTENT_ANCHOR_SIGNER_SECRET_KEY=[12,34,56,...]

# =============================================================================
# P2 / Optional Expansion / 后续扩展或兼容老流程
# =============================================================================

# R2_EDGE_* / 后续边缘镜像预留
# CN: 如需恢复旧版 hybrid storage.ts 的双写模式，建议新建 R2_EDGE_*，不要复用当前 origin R2 bucket。
# EN: Reserved for a future edge mirror bucket if the legacy hybrid storage.ts dual-write flow is revived.
# R2_EDGE_REGION=auto
# R2_EDGE_BUCKET=

# CHAINLINK_* / Chainlink Functions 预留
# CN: 当前只是示例脚本占位，后续如果接 Chainlink Functions 再启用。
# EN: Reserved for future Chainlink Functions integration; currently used only by example scaffolding.
CHAINLINK_SOURCE_API_BASE_URL=https://api.example.com
CHAINLINK_GATEWAY_URL=

# =============================================================================
# Reserved For Next Phase / 下一阶段预留，当前代码尚未读取
# =============================================================================

# CN: 如果后续接入托管钱包/嵌入式钱包，可以在这里补充对应认证服务变量。
# EN: Reserved placeholders for future managed-wallet / embedded-wallet integrations.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# WEB3AUTH_CLIENT_ID=
