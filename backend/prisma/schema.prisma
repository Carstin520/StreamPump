// CN: StreamPump backend Prisma schema，定义内容清单、proposal intent、链上投影和事件存储。
// EN: StreamPump backend Prisma schema defining content manifests, proposal intents, on-chain projections, and event storage.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProposalStatus {
  OPEN
  FUNDED
  RESOLVED_SUCCESS
  RESOLVED_FAIL
  CANCELLED
  VOIDED
}

enum Track2MetricType {
  VIEWS
  CLICKS
  SAVES
}

enum OracleSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum FraudStatus {
  ACCEPTED
  REVIEW
  REJECTED
}

enum ContentType {
  SHORT_VIDEO
  IMAGE_CAROUSEL
  MIXED_MEDIA_NOTE
}

enum ContentManifestStatus {
  DRAFT
  UPLOADING
  READY
  LOCKED
  ANCHORED
  PUBLISHED
  ARCHIVED
}

enum AssetType {
  IMAGE
  VIDEO
  COVER
}

enum AssetUploadStatus {
  PENDING
  UPLOADED
  FAILED
}

enum AssetProcessingStatus {
  NONE
  PREPARING
  READY
  ERRORED
}

enum AssetProcessingSource {
  CLIENT_COMPLETE
  MUX_WEBHOOK
  MUX_RECONCILIATION
}

enum PublicationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProposalIntentStatus {
  DRAFT
  TERMS_LOCKED
  BUNDLE_BUILT
  CREATOR_PARTIALLY_SIGNED
  SPONSOR_SIGNED
  SUBMITTED
  CONFIRMED
  FAILED
  EXPIRED
}

enum BundleStatus {
  BUILT
  PARTIAL
  FULLY_SIGNED
  SUBMITTED
  CONFIRMED
  FAILED
  EXPIRED
}

enum BundleSubmitMode {
  SERVER_RELAY
  CLIENT_RELAY
}

enum IdentityProvider {
  GOOGLE
  APPLE
  EMAIL
  PASSKEY
  TWITTER
}

enum AccountRole {
  FAN
  CREATOR
  SPONSOR
}

enum SponsorVerificationStatus {
  UNSUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SponsorType {
  BRAND
  AGENCY
  INDIVIDUAL
}

enum MarketCreatorStage {
  S1_DISCOVERY
  S1_BUYOUT
  S2_ACTIVE
}

enum BuyoutOfferProjectionStatus {
  OPEN
  ACCEPTED
  CANCELLED
  RECLAIMED
  ABORTED
}

enum BuyoutProjectionStatus {
  NONE
  AUCTION_OPEN
  OFFER_ACCEPTED
  RAGE_QUIT_OPEN
  GRADUATED
}

enum CampaignProofStatus {
  DRAFT
  FUNDED
  ANCHORED
  SETTLING
  SETTLED
  CANCELLED
  VOIDED
}

enum ApiIdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum SettlementTrack {
  TRACK1
}

enum Track1SettlementOperationStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model Proposal {
  id                          String              @id @default(cuid())
  /// CN: 链上 Proposal PDA，数据库用它和链上账户强绑定。
  /// EN: On-chain Proposal PDA used as the canonical binding key between DB rows and chain accounts.
  proposalPda                 String              @unique
  creatorWallet               String
  sponsorWallet               String?
  sponsorOrgId                String?
  creatorOrgId                String?
  /// CN: 绑定的内容清单版本 ID。
  /// EN: Bound content manifest version ID.
  manifestId                  String?
  manifest                    ContentManifest?    @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  /// CN: 发起 proposal 前的业务草稿 ID。
  /// EN: Business-draft intent ID created before the on-chain proposal exists.
  intentId                    String?             @unique
  intent                      ProposalIntent?     @relation(fields: [intentId], references: [id], onDelete: SetNull)
  /// CN: 内容清单的 32-byte SHA-256 十六进制摘要。
  /// EN: 32-byte SHA-256 hex digest of the bound content manifest.
  contentHashHex              String?
  /// CN: 内容锚点 PDA，指向链上的 content anchor 账户。
  /// EN: Content anchor PDA pointing to the on-chain content anchor account.
  contentAnchorPda            String?
  contentAnchorTx             String?
  deadlineAt                  DateTime
  status                      ProposalStatus      @default(OPEN)
  track1BaseUsdc              BigInt
  track1Claimed               Boolean             @default(false)
  track2MetricType            Track2MetricType
  track2TargetValue           BigInt
  track2MinAchievementBps     Int
  track2UsdcDeposited         BigInt
  track2ActualValue           BigInt?
  track2SettledAt             DateTime?
  track2InitialFanPool        BigInt              @default(0)
  track2InitialSpumpStaked    BigInt              @default(0)
  track2RewardCapUsdc         BigInt              @default(0)
  track2ResidualTo            Int                 @default(1)
  track2RewardModelSnapshot   Int                 @default(0)
  track3UsdcDeposited         BigInt
  track3CpsPayout             BigInt?
  track3DelayDays             Int
  track3SettledAt             DateTime?
  /// CN: 最近一次链上提交或结算交易签名。
  /// EN: Most recent chain submission or settlement transaction signature.
  onChainTxSignature          String?
  /// CN: 链上 Proposal PDA nonce，来自 launch intent 或链上 Proposal 状态。
  /// EN: On-chain Proposal PDA nonce copied from launch intent or chain state.
  nonce                       BigInt?
  oracleSyncStatus            OracleSyncStatus    @default(PENDING)
  oracleLastError             String?
  /// CN: 内容已发布且通过后端/人工核验的时间。
  /// EN: Timestamp when content publication has been verified by backend/manual review.
  contentPublishedVerifiedAt  DateTime?
  /// CN: 从 proposal 状态派生的公开证明状态（DRAFT/FUNDED/ANCHORED/SETTLING/SETTLED/CANCELLED/VOIDED）。
  /// EN: Public proof status derived from proposal state (replaces CampaignProofProjection).
  proofStatus                 CampaignProofStatus @default(DRAFT)
  /// CN: 注资成功时的链上交易签名。
  /// EN: On-chain transaction signature when funding was confirmed.
  fundingTxSignature          String?
  /// CN: 最近一次结算交易签名。
  /// EN: Most recent settlement transaction signature.
  latestSettlementTxSignature String?
  /// CN: 当前 endorse 的总人数。
  /// EN: Total number of unique endorsers for this proposal.
  endorserCount               Int                 @default(0)
  /// CN: 所有 endorser 累计质押的 SPUMP 总量。
  /// EN: Total SPUMP staked by all endorsers.
  totalSpumpStaked            BigInt              @default(0)
  /// CN: 已 claim 的 endorser 数量。
  /// EN: Number of endorsers who have claimed their reward.
  claimedEndorserCount        Int                 @default(0)
  metadata                    Json?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  track2Events                Track2Event[]
  track1SettlementOperations  Track1SettlementOperation[]

  @@index([status, track1Claimed])
  @@index([status, deadlineAt, track2SettledAt])
  @@index([deadlineAt, track3DelayDays, track3SettledAt])
  @@index([manifestId])
}

model Track1SettlementOperation {
  id                    String                          @id @default(cuid())
  proposalId            String
  proposal              Proposal                        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  proposalPda           String
  track                 SettlementTrack                 @default(TRACK1)
  idempotencyKey        String
  payloadHash           String
  operatorIdentity      String
  evidenceDigest        String
  status                Track1SettlementOperationStatus @default(PENDING)
  txSignature           String?
  errorCode             String?
  errorMessage          String?
  attemptCount          Int                             @default(0)
  leaseToken            String?
  leaseExpiresAt        DateTime?
  lastAttemptAt         DateTime?
  submittedAt           DateTime?
  confirmedAt           DateTime?
  failedAt              DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  @@unique([proposalPda, track])
  @@index([idempotencyKey])
  @@index([status, updatedAt])
  @@index([proposalId, createdAt])
}

model S2EndorsementPositionProjection {
  id                   String    @id @default(cuid())
  positionPda          String    @unique
  userWallet           String
  proposalPda          String
  stakedSpumpAmount    BigInt    @default(0)
  /// CN: 已提取（部分 unstake）的 SPUMP 数量。
  /// EN: Total SPUMP amount withdrawn via partial unstake.
  withdrawnSpumpAmount BigInt    @default(0)
  /// CN: 最近一次提取时间。
  /// EN: Timestamp of the most recent withdrawal.
  withdrawnAt          DateTime?
  /// CN: 因提前退出而被扣除的罚金数量（SPUMP）。
  /// EN: Penalty SPUMP amount deducted due to early withdrawal.
  penaltySpumpAmount   BigInt    @default(0)
  /// CN: 累计部分 unstake 次数。
  /// EN: Cumulative number of partial unstake operations.
  partialUnstakeCount  Int       @default(0)
  claimedStatus        Boolean   @default(false)
  estimatedUsdcReward  BigInt    @default(0)
  rewardCapUsdc        BigInt    @default(0)
  rewardCapped         Boolean   @default(false)
  fanPoolRemaining     BigInt    @default(0)
  residualTransferred  BigInt    @default(0)
  lastEventSignature   String?
  lastEventAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userWallet, proposalPda])
  @@index([proposalPda, claimedStatus])
  @@index([userWallet, updatedAt])
}

model ContentManifest {
  id                    String                @id @default(cuid())
  creatorWallet         String
  contentType           ContentType
  status                ContentManifestStatus @default(DRAFT)
  isPublicFeedEligible  Boolean               @default(false)
  publishedAt           DateTime?
  publicSlug            String?
  creatorDisplayName    String?
  publicExcerpt         String?
  /// CN: 内容版本号。草稿变更通过新版本推进，而不是覆盖已绑定版本。
  /// EN: Content version number. Mutations should advance via new versions instead of mutating already-bound content.
  version               Int                   @default(1)
  title                 String?
  captionText           String?
  captionTextHash       String?
  tagsJson              Json?
  metadataJson          Json?
  /// CN: 规范化后的 manifest JSON，用于计算内容摘要。
  /// EN: Canonicalized manifest JSON used to derive the content digest.
  canonicalManifestJson Json?
  /// CN: manifest 的 SHA-256 十六进制摘要，对应链上的 content_hash。
  /// EN: SHA-256 hex digest of the manifest, matching the on-chain content_hash.
  manifestHashHex       String?               @unique
  /// CN: 后端内部 canonical URL，不依赖外部平台发帖链接。
  /// EN: Backend-owned canonical URL that does not depend on an external platform post URL.
  internalCanonicalUrl  String?               @unique
  /// CN: internalCanonicalUrl 的 Keccak 摘要，对应链上 url_digest。
  /// EN: Keccak digest of internalCanonicalUrl, matching the on-chain url_digest.
  internalUrlDigestHex  String?
  /// CN: 当前版本 manifest 对应的链上内容锚点 PDA。
  /// EN: On-chain content anchor PDA for the current manifest version.
  currentAnchorPda      String?               @unique
  currentAnchorTx       String?
  /// CN: 封面资产 ID；未显式指定时通常回退到第一个素材。
  /// EN: Cover asset ID; usually falls back to the first asset when unspecified.
  coverAssetId          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  assets                ContentAsset[]
  publications          ContentPublication[]
  proposalIntents       ProposalIntent[]
  proposals             Proposal[]

  @@index([creatorWallet, status])
  @@index([creatorWallet, version])
  @@index([isPublicFeedEligible, publishedAt, createdAt])
}

model ApiIdempotencyRecord {
  id                 String               @id @default(cuid())
  wallet             String
  method             String
  scope              String
  keyHash            String
  requestHash        String
  status             ApiIdempotencyStatus @default(IN_PROGRESS)
  leaseToken         String?
  leaseExpiresAt     DateTime?
  resourceType       String?
  resourceId         String?
  responseStatus     Int?
  responseBody       Json?
  responseSizeBytes  Int?
  responseExpiresAt  DateTime?
  lastErrorCode      String?
  attemptCount       Int                  @default(1)
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([wallet, method, scope, keyHash])
  @@index([status, leaseExpiresAt])
  @@index([resourceType, resourceId])
}

model ContentAsset {
  id                   String                 @id @default(cuid())
  manifestId           String
  manifest             ContentManifest        @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  assetType            AssetType
  /// CN: 素材在 manifest 内的稳定顺序，用于生成 canonical manifest hash。
  /// EN: Stable per-manifest ordering used when generating the canonical manifest hash.
  orderIndex           Int
  /// CN: 原始文件内容的 SHA-256 十六进制摘要。
  /// EN: SHA-256 hex digest of the raw uploaded file.
  sha256Hex            String
  mimeType             String
  fileSizeBytes        BigInt
  width                Int?
  height               Int?
  durationMs           Int?
  /// CN: 对象存储中的稳定 key，作为 S3/R2 与 DB 的桥接主键。
  /// EN: Stable object-storage key that bridges S3/R2 objects with DB state.
  storageKey           String                 @unique
  cdnUrl               String?
  /// CN: Mux 资产 ID，用于转码状态与播放地址回写。
  /// EN: Mux asset ID used to reconcile processing status and playback info.
  muxAssetId           String?                @unique
  /// CN: Mux playback ID，对应最终可播放资源。
  /// EN: Mux playback ID for the final playable asset.
  muxPlaybackId        String?                @unique
  /// CN: 最近一次从 Mux 观察到的原始状态，如 preparing / ready / errored。
  /// EN: Last raw status observed from Mux, such as preparing / ready / errored.
  muxLastKnownStatus   String?
  /// CN: 最近一次收到 Mux webhook 的时间。
  /// EN: Timestamp when the most recent Mux webhook was received.
  muxWebhookReceivedAt DateTime?
  /// CN: 最近一次主动向 Mux 查询资产状态的时间。
  /// EN: Timestamp of the most recent active reconciliation query against Mux.
  muxLastCheckedAt     DateTime?
  /// CN: 主动 reconciliation 已尝试的次数。
  /// EN: Number of active reconciliation attempts executed so far.
  muxReconcileAttempts Int                    @default(0)
  /// CN: 视频被确认为 ready 的时间，无论来源是 webhook 还是补偿任务。
  /// EN: Timestamp when the video was confirmed ready, whether by webhook or reconciliation.
  muxReadyAt           DateTime?
  uploadStatus         AssetUploadStatus      @default(PENDING)
  processingStatus     AssetProcessingStatus  @default(NONE)
  /// CN: 当前 processing 状态是由哪条链路推进的。
  /// EN: Source that most recently advanced the processing state.
  processingSource     AssetProcessingSource?
  processingError      String?
  /// SHA-256 recomputed by the backend from the stored object after upload completion.
  verifiedSha256Hex    String?
  /// Byte count observed while the backend streamed the stored object for verification.
  verifiedSizeBytes    BigInt?
  /// Object ETag observed during backend storage verification.
  objectEtag           String?
  /// Time when object size, MIME type, and SHA-256 were last verified by the backend.
  storageVerifiedAt    DateTime?
  /// Last fail-closed storage verification error, cleared only by a successful verification.
  storageVerificationError String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([manifestId, orderIndex])
  @@index([manifestId, assetType])
  @@index([uploadStatus, processingStatus])
}

model ContentPublication {
  id                   String                        @id @default(cuid())
  manifestId           String
  manifest             ContentManifest               @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  platform             String
  /// CN: 外部平台帖子 ID 的摘要，避免在 DB 中直接依赖原始平台 ID。
  /// EN: Digest of the external platform post ID to avoid coupling directly to raw platform identifiers.
  externalPostIdHash   String?
  externalUrl          String
  /// CN: externalUrl 的摘要，可用于后续去重和链下证据比对。
  /// EN: Digest of externalUrl for later dedupe and off-chain evidence matching.
  externalUrlDigestHex String
  verificationStatus   PublicationVerificationStatus @default(PENDING)
  verificationSource   String?
  verificationReviewer String?
  verificationNote     String?
  verificationEvidenceDigestHex String?
  verifiedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@unique([platform, externalUrl])
  @@index([manifestId, platform, verificationStatus])
}

model ProposalIntent {
  id                      String               @id @default(cuid())
  status                  ProposalIntentStatus @default(DRAFT)
  version                 Int                  @default(1)
  creatorWallet           String
  sponsorWallet           String
  sponsorOrgId            String?
  creatorOrgId            String?
  manifestId              String
  manifest                ContentManifest      @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  /// CN: lock 时冻结的 manifest 摘要，确保 sponsor 和 creator 面对的是同一版内容。
  /// EN: Manifest digest frozen at lock time so sponsor and creator operate on the exact same content version.
  lockedManifestHashHex   String?
  /// CN: lock 时冻结的内容锚点 PDA；为空表示 launch bundle 里需要先 anchor。
  /// EN: Content anchor PDA frozen at lock time; null means the launch bundle still needs an anchor step.
  lockedAnchorPda         String?
  deadlineUnix            BigInt
  track1BaseUsdc          BigInt
  track2MetricType        Track2MetricType
  track2TargetValue       BigInt
  track2MinAchievementBps Int
  /// CN: Track2 预算（USDC 最小单位），用于 sponsor_fund 真实注资。
  /// EN: Track2 budget in USDC base units, used for the actual sponsor_fund instruction.
  track2UsdcDeposited     BigInt               @default(0)
  track3UsdcDeposited     BigInt
  track3DelayDays         Int
  /// CN: 提案 PDA nonce，允许同一创作者、同一截止时间创建多个提案。
  /// EN: Proposal PDA nonce allowing multiple proposals per creator per deadline.
  nonce                   BigInt               @default(0)
  /// CN: 该提案的最大 SPUMP 背书总量上限（0 = 不限制）。
  /// EN: Maximum total SPUMP endorsement for this proposal (0 = uncapped).
  maxEndorsementSpump     BigInt               @default(0)
  /// CN: 预推导的 Proposal PDA，供 bundle 组装和后续链上投影使用。
  /// EN: Pre-derived Proposal PDA used during bundle assembly and later on-chain projection.
  plannedProposalPda      String?
  /// CN: 预推导的 proposal USDC 金库 PDA。
  /// EN: Pre-derived proposal USDC vault PDA.
  plannedUsdcVaultPda     String?
  creatorApprovedAt       DateTime?
  sponsorApprovedAt       DateTime?
  chainTxSignature        String?
  chainSubmittedAt        DateTime?
  chainConfirmedAt        DateTime?
  failureReason           String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  proposal                Proposal?
  txBundles               TxBundle[]

  @@index([creatorWallet, status])
  @@index([sponsorWallet, status])
  @@index([manifestId, status])
}

model TxBundle {
  id                    String           @id @default(cuid())
  intentId              String
  intent                ProposalIntent   @relation(fields: [intentId], references: [id], onDelete: Cascade)
  bundleType            String
  /// CN: 计划打包进交易的 instruction 顺序。
  /// EN: Ordered instruction plan intended for the transaction bundle.
  instructionPlanJson   Json
  /// CN: 序列化后的真实 VersionedTransaction（base64）。
  /// EN: Serialized real VersionedTransaction encoded as base64.
  messageBase64         String?
  partiallySignedBase64 String?
  fullySignedBase64     String?
  recentBlockhash       String?
  lastValidBlockHeight  BigInt?
  /// CN: 此 bundle 需要哪些签名者。
  /// EN: The signer set required to make this bundle valid.
  requiredSignersJson   Json
  expiresAt             DateTime
  submitMode            BundleSubmitMode
  status                BundleStatus     @default(BUILT)
  chainTxSignature      String?
  errorMessage          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([intentId, status])
  @@index([expiresAt, status])
}

model ChainEvent {
  id               String   @id @default(cuid())
  /// CN: 对应链上交易签名；一笔交易内可能产生多条事件记录。
  /// EN: On-chain transaction signature; one transaction may yield multiple event rows.
  signature        String
  /// CN: 指令在交易消息内的顺序，用来和 signature 一起保证唯一性。
  /// EN: Instruction order inside the transaction message, used with the signature for uniqueness.
  instructionIndex Int
  slot             BigInt
  programId        String
  /// CN: 通过 IDL 指令解码得到的指令名。
  /// EN: Instruction name decoded from the IDL.
  instructionName  String
  proposalPda      String?
  /// CN: 事件主实体地址；没有 proposal 时可回落到 creator_profile/content_anchor 等地址。
  /// EN: Primary entity address for the event; falls back to creator_profile/content_anchor when no proposal exists.
  entityPda        String?
  payloadJson      Json?
  observedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([signature, instructionIndex])
  @@index([proposalPda, observedAt])
  @@index([instructionName, observedAt])
}

model CreatorMarketProjection {
  id                      String             @id @default(cuid())
  creatorWallet           String             @unique
  creatorProfilePda       String             @unique
  handle                  String?
  displayName             String?
  stage                   MarketCreatorStage @default(S1_DISCOVERY)
  level                   Int                @default(1)
  s1Supply                BigInt             @default(0)
  currentPriceSpump       BigInt             @default(0)
  nextPriceSpump          BigInt             @default(0)
  supporterPoolSpump      BigInt             @default(0)
  holderCount             Int                @default(0)
  s1EligibleHolderCount   Int                @default(0)
  s1EarlyHolderCount      Int                @default(0)
  s1RegularHolderCount    Int                @default(0)
  graduationProgressBps   Int                @default(0)
  activeCampaignCount     Int                @default(0)
  latestBuyoutOfferUsdc   BigInt?
  acceptedBuyoutOfferUsdc BigInt?
  buyoutStatePda          String?
  lastEventSignature      String?
  lastEventAt             DateTime?
  metadataJson            Json?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([stage, updatedAt])
  @@index([creatorProfilePda])
}

model S1PositionProjection {
  id                     String    @id @default(cuid())
  userWallet             String
  creatorWallet          String?
  creatorProfilePda      String
  positionPda            String    @unique
  internalTokenBalance   BigInt    @default(0)
  earlyCohortBalance     BigInt    @default(0)
  spumpCostBasis         BigInt    @default(0)
  estimatedClaimableUsdc BigInt?
  discoveryRewardClaimed Boolean   @default(false)
  lastDiscoveryRewardUsdc BigInt   @default(0)
  discoveryRewardCapped  Boolean   @default(false)
  discoveryRewardEligible Boolean  @default(false)
  lastEventSignature     String?
  lastEventAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([userWallet, creatorProfilePda])
  @@index([creatorWallet])
  @@index([userWallet])
}

model S1BuyoutOfferProjection {
  id                   String                      @id @default(cuid())
  buyoutOfferPda       String                      @unique
  creatorWallet        String?
  creatorProfilePda    String
  sponsorWallet        String
  usdcAmount           BigInt
  status               BuyoutOfferProjectionStatus @default(OPEN)
  createdOnChainAt     DateTime?
  sponsorCancelAfterAt DateTime?
  lastEventSignature   String?
  lastEventAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([creatorProfilePda, status])
  @@index([sponsorWallet, status])
}

model S1BuyoutProjection {
  id                                String                 @id @default(cuid())
  creatorWallet                     String?
  creatorProfilePda                 String                 @unique
  buyoutStatePda                    String?                @unique
  status                            BuyoutProjectionStatus @default(NONE)
  winningSponsorWallet              String?
  acceptedOfferPda                  String?
  acceptedOfferUsdc                 BigInt?
  latestOfferPda                    String?
  latestOfferUsdc                   BigInt?
  usdcDeposited                     BigInt                 @default(0)
  claimableUsdcRemaining            BigInt                 @default(0)
  claimableS1SupplyRemaining        BigInt                 @default(0)
  creatorPayoutUsdc                 BigInt                 @default(0)
  discoveryPoolUsdc                 BigInt                 @default(0)
  discoveryPoolRemaining            BigInt                 @default(0)
  eligibleHolderCount               Int                    @default(0)
  earlyHolderCount                  Int                    @default(0)
  regularHolderCount                Int                    @default(0)
  rewardModelSnapshot               Int                    @default(1)
  residualToSnapshot                Int                    @default(0)
  discoveryRewardCapUsdc            BigInt                 @default(0)
  statusThankyouUsdc                BigInt                 @default(0)
  creatorPaid                       Boolean                @default(false)
  graduatedAt                       DateTime?
  residualSweptAt                   DateTime?
  residualSwept                     Boolean                @default(false)
  vaultClosed                       Boolean                @default(false)
  earlyClaimableUsdcRemaining       BigInt                 @default(0)
  earlyClaimableS1SupplyRemaining   BigInt                 @default(0)
  regularClaimableUsdcRemaining     BigInt                 @default(0)
  regularClaimableS1SupplyRemaining BigInt                 @default(0)
  rageQuitDeadlineAt                DateTime?
  lastEventSignature                String?
  lastEventAt                       DateTime?
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @updatedAt

  @@index([status, updatedAt])
  @@index([creatorWallet])
}

model IndexerCursor {
  /// CN: cursor 的消费者键，例如 streampump_core_logs。
  /// EN: Consumer key for the cursor, for example streampump_core_logs.
  consumerKey       String   @id
  lastSeenSlot      BigInt   @default(0)
  lastSeenSignature String?
  updatedAt         DateTime @updatedAt
}

model WalletAuthChallenge {
  id         String    @id @default(cuid())
  wallet     String
  nonce      String    @unique
  message    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([wallet, expiresAt])
}

model EmailAuthChallenge {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email, expiresAt])
}

model WalletSession {
  id         String    @id
  wallet     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([wallet, expiresAt])
}

model AuthIdentity {
  id                   String           @id @default(cuid())
  provider             IdentityProvider
  providerSubject      String
  email                String?
  displayName          String?
  /// CN: 产品内托管/嵌入式钱包地址，用于把社交身份映射回统一的链上会话主体。
  /// EN: Product-managed / embedded wallet address that maps social identities back to a unified on-chain session subject.
  managedWalletAddress String           @unique
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([provider, providerSubject])
  @@index([managedWalletAddress])
}

model AccountProfile {
  id                    String          @id @default(cuid())
  wallet                String          @unique
  role                  AccountRole     @default(FAN)
  displayName           String?
  handle                String?         @unique
  onboardingCompletedAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  /// CN: 关联的多钱包列表。
  /// EN: Associated wallets for this account.
  wallets               AccountWallet[]

  @@index([role, onboardingCompletedAt])
}

enum WalletType {
  MANAGED
  EXTERNAL
}

enum ManagedWalletPoolStatus {
  AVAILABLE
  ASSIGNED
  USED
}

enum ManagedWalletJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// CN: 账户多钱包关联表，支持托管钱包和外部钱包绑定。
/// EN: Multi-wallet join table for accounts, supporting both managed and external wallet bindings.
model AccountWallet {
  id                 String         @id @default(cuid())
  accountProfileId   String
  accountProfile     AccountProfile @relation(fields: [accountProfileId], references: [id], onDelete: Cascade)
  walletAddress      String         @unique
  walletType         WalletType     @default(MANAGED)
  isPrimary          Boolean        @default(false)
  label              String?
  /// Encrypted secret key bytes (only for MANAGED wallets; null for EXTERNAL)
  encryptedSecretKey Bytes?
  /// CN: Demo day 托管钱包池状态；null 表示不是池内钱包。
  /// EN: Demo-day managed wallet pool state; null means this wallet is not in the pool.
  poolStatus         ManagedWalletPoolStatus?
  /// CN: HMAC 后的 ephemeral subject，用于扫码幂等复用且不存明文 subject。
  /// EN: HMACed ephemeral subject for idempotent assignment without storing the raw subject.
  poolSubjectHash    String?        @unique
  poolAssignedAt     DateTime?
  poolUsedAt         DateTime?
  boundAt            DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([accountProfileId])
  @@index([walletType, poolStatus])
}

model ManagedWalletExecutionJob {
  id             String                 @id @default(cuid())
  wallet         String
  sessionId      String?
  idempotencyKey String
  action         String
  params         Json?
  status         ManagedWalletJobStatus @default(QUEUED)
  signature      String?
  projectionSync Json?
  errorCode      String?
  errorMessage   String?
  attempts       Int                    @default(0)
  queuedAt       DateTime               @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([wallet, idempotencyKey])
  @@index([status, queuedAt])
  @@index([wallet, createdAt])
}

model SponsorProfile {
  id                  String                    @id @default(cuid())
  wallet              String                    @unique
  companyName         String
  sponsorType         SponsorType               @default(BRAND)
  registrationNumber  String
  businessLicenseKey  String
  legalRepresentative String
  contactPhone        String
  contactEmail        String
  powerOfAttorneyKey  String?
  status              SponsorVerificationStatus @default(UNSUBMITTED)
  rejectReason        String?
  approvedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  /// CN: KYB 审核事件审计日志。
  /// EN: KYB review event audit trail.
  reviewEvents        SponsorReviewEvent[]

  @@index([status, updatedAt])
  @@index([sponsorType, status])
}

/// CN: Sponsor KYB 审核事件，记录每次状态变更的审计轨迹。
/// EN: Sponsor KYB review event recording an immutable audit trail of each verification status change.
model SponsorReviewEvent {
  id               String                    @id @default(cuid())
  sponsorProfileId String
  sponsorProfile   SponsorProfile            @relation(fields: [sponsorProfileId], references: [id], onDelete: Cascade)
  reviewerWallet   String
  previousStatus   SponsorVerificationStatus
  newStatus        SponsorVerificationStatus
  reason           String?
  note             String?
  documentSnapshot Json?
  createdAt        DateTime                  @default(now())

  @@index([sponsorProfileId, createdAt])
  @@index([reviewerWallet])
}

model Track2Event {
  id              String           @id @default(cuid())
  proposalId      String
  proposal        Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  eventType       Track2MetricType
  externalEventId String?
  userId          String?
  sessionId       String?
  ipHash          String
  userAgent       String?
  fraudStatus     FraudStatus      @default(ACCEPTED)
  fraudScore      Int              @default(0)
  occurredAt      DateTime         @default(now())
  /// CN: 去重键，避免同一事件被重复记账。
  /// EN: Dedupe key that prevents the same event from being counted multiple times.
  dedupeKey       String           @unique
  /// CN: 原始 webhook/body 负载，供排障和风控回放使用。
  /// EN: Raw webhook/body payload used for debugging and fraud-review replay.
  rawPayload      Json?
  /// CN: 人工审核者钱包或标识。
  /// EN: Wallet address or identifier of the manual reviewer.
  reviewedBy      String?
  /// CN: 审核完成时间。
  /// EN: Timestamp when the review was completed.
  reviewedAt      DateTime?
  /// CN: 审核备注。
  /// EN: Free-text note left by the reviewer.
  reviewNote      String?
  /// CN: 审核来源（如 manual、auto-rule、oracle）。
  /// EN: Source of the review decision (e.g. manual, auto-rule, oracle).
  reviewSource    String?
  createdAt       DateTime         @default(now())

  @@index([proposalId, eventType, fraudStatus])
  @@index([proposalId, occurredAt])
}
