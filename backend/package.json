{
  "name": "streampump-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "import:local-post-assets": "npm run build && node dist/scripts/import-local-post-assets.js",
    "backfill:image-variants": "npm run build && node dist/scripts/backfill-image-variants.js",
    "update:local-post-cover": "npm run build && node dist/scripts/update-local-post-cover.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "verify:p4:neon:post": "P4_M3_EXPECTED_PHASE=post P4_M3_POST_DATA_MODE=runtime node dist/scripts/p4-verify-neon-migration.js",
    "verify:p4:neon:baseline": "P4_M3_EXPECTED_PHASE=post P4_M3_POST_DATA_MODE=migration-baseline node dist/scripts/p4-verify-neon-migration.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@coral-xyz/anchor": "^0.32.1",
    "@mux/mux-node": "^12.8.1",
    "@prisma/client": "^6.19.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "redis": "^4.7.0",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.17",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
