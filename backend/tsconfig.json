{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.d.ts", "config/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
