{
  "name": "streampump-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:anchor": "scripts/anchor-build-fast.sh",
    "cover:videos": "scripts/generate-video-cover.sh",
    "demo:protocol:migrate": "ts-node --transpile-only scripts/devnet-migrate-protocol-config.ts",
    "demo:s1:backfill-buyout": "ts-node --transpile-only scripts/backfill-s1-buyout-projection.ts",
    "demo:seed:localnet": "ts-node scripts/seed-colosseum-localnet.ts",
    "demo:s1:devnet": "ts-node --transpile-only scripts/devnet-s1-buyout-claim-seed.ts",
    "demo:s2:devnet": "ts-node --transpile-only scripts/devnet-s2-happy-path.ts",
    "devnet:upgrade:fyph": "ts-node --transpile-only scripts/devnet-upgrade-program-buffered.ts",
    "test:anchor": "anchor test",
    "test:backend": "ts-mocha -p backend/tsconfig.test.json backend/tests/**/*.spec.ts",
    "test:s1:buyout": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} ts-mocha -p ./tsconfig.json -t 1000000 programs/tests/s1-buyout.spec.ts",
    "test:s1:buyout:unhappy": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} ts-mocha -p ./tsconfig.json -t 1000000 programs/tests/s1-buyout-unhappy-path.spec.ts",
    "test:s1:guards": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} ts-mocha -p ./tsconfig.json -t 1000000 programs/tests/s1-guards.spec.ts",
    "test:s1:happy": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} ts-mocha -p ./tsconfig.json -t 1000000 programs/tests/s1-happy-path.spec.ts",
    "test:s1:unhappy": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} ts-mocha -p ./tsconfig.json -t 1000000 programs/tests/s1-unhappy-path.spec.ts",
    "test:s2:unhappy": "ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} ts-mocha -p ./tsconfig.json -t 1000000 programs/tests/s2-unhappy-path.spec.ts",
    "test:unhappy:backend": "ts-mocha -p backend/tsconfig.test.json backend/tests/s1MarketProjectionUnhappyPath.spec.ts backend/tests/proposalLaunchService.spec.ts backend/tests/marketProjectionService.spec.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.8",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "mocha": "^11.1.0",
    "ts-mocha": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
