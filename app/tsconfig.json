{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    ".next",
    ".next-dev",
    ".next-*",
    ".next_*",
    "src/**/* 2.ts",
    "src/**/* 2.tsx",
    "src/components/Wallet/**/*",
    "src/components/Dashboard/**/*",
    "src/components/VideoPlayer/**/*",
    "src/hooks/useBondingCurve.ts",
    "src/hooks/useCreatorUpgradePayload.ts",
    "src/hooks/useProgram.ts",
    "src/hooks/useProposalOracleReport.ts",
    "src/utils/proposalPda.ts",
    "src/utils/solana.ts"
  ]
}
