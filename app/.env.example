# =============================================================================
# CN: StreamPump frontend environment example.
# EN: StreamPump frontend environment example.
# =============================================================================

# NEXT_PUBLIC_BACKEND_BASE_URL / 前端访问后端的基准地址
# CN: 这里只填后端源站，不要包含额外路径；前端代码会自行拼接 /api/...。
# EN: Backend origin only. Do not append extra paths; the frontend code appends /api/... itself.
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:4000

# NEXT_PUBLIC_API_BASE_URL / 兼容旧变量名
# CN: 老代码可能仍读取这个完整 API 路径；新配置优先使用 NEXT_PUBLIC_BACKEND_BASE_URL。
# EN: Backward-compatible full API base path. New setups should prefer NEXT_PUBLIC_BACKEND_BASE_URL.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# NEXT_PUBLIC_RPC_ENDPOINT / Solana RPC 地址
# CN: 钱包、只读链上查询和前端签名流都依赖它。
# EN: Used by wallet connections, read-only chain queries, and frontend signing flows.
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# NEXT_IMAGE_REMOTE_HOSTS / Next Image 允许优化的远程图片域名
# CN: 仅填写你控制的公开素材/CDN 域名，逗号分隔；路径在 next.config.js 中限制为 /content/**。
# EN: Comma-separated public media/CDN hosts controlled by this app; next.config.js limits paths to /content/**.
NEXT_IMAGE_REMOTE_HOSTS=pub-b0acd300bcec4dc5ba5ea36628dd809f.r2.dev

# NEXT_PUBLIC_WEB3AUTH_CLIENT_ID / Web3Auth 客户端 ID
# CN: 如果你继续保留 Web3Auth 社交登录，请填写它；否则可以先留空。
# EN: Fill this if you continue using Web3Auth social login; otherwise it can stay empty for now.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# NEXT_PUBLIC_ENABLE_PREVIEW_SOCIAL_AUTH / 预览社交登录开关
# CN: 仅本地/录屏 demo 可设 true；公开预览请保持 false 并使用钱包签名登录。
#     它同时是「预览 provider-exchange 身份路径」的开关（例如 /try 备用访客会话、
#     portfolio 的「平台钱包」入口）；关闭时真实鉴权失败不会静默切换身份。
# EN: Set true only for local/video demos; public previews should keep false and use wallet signature login.
#     Also gates the preview provider-exchange identity path (e.g. the /try guest
#     fallback session and the portfolio "platform wallet" shortcut). When false, a
#     failed real auth call never silently swaps identity mode.
#     On the /login screen the demo identity paths (email OTP, Google/Apple, the
#     account switcher, local sessions, managed-wallet choice) require BOTH this
#     flag AND NEXT_PUBLIC_ENABLE_PUBLIC_DEMO. Default login exposes only wallet
#     challenge + signature; there is no implicit NODE_ENV=development fallback.
NEXT_PUBLIC_ENABLE_PREVIEW_SOCIAL_AUTH=false

# NEXT_PUBLIC_ENABLE_PUBLIC_DEMO / 公开 Demo 总开关（默认 false）
# CN: 控制所有面向公众的 demo/种子回退路径：/try 扫码落地页、活动页种子样例回退、
#     Track2 应援 / Track3 结算本地模拟器、portfolio「平台钱包」种子入口。
#     生产默认关闭——关闭时这些界面显示真实数据或诚实的空/错误状态，绝不冒充 LIVE。
#     仅在明确标注 SEEDED_DEMO / 预览的构建里设为 true，且开启后仍保留可读性标签。
# EN: Master gate for every public-facing demo / seeded fallback: the /try scan
#     landing, seeded campaign-fixture fallback, the Track 2 endorsement / Track 3
#     settlement local simulators, and the portfolio "platform wallet" seeded
#     shortcut. Defaults false for production — when off, these surfaces show real
#     data or an honest empty/error state and never present seeded data as LIVE.
#     Set true ONLY for explicitly-labeled SEEDED_DEMO / preview builds; gated
#     surfaces keep their readiness notices even when enabled.
#     It also opens the invite-only "closed lanes" (routes with on-chain fund
#     actions: /market/[creatorId], /buyout/[creatorId], /portfolio, /rewards,
#     /campaigns/[proposalId]/endorse). When false these render an honest
#     Pilot-closed surface with no transaction UI; the read-only campaign
#     proof/detail route stays open.
NEXT_PUBLIC_ENABLE_PUBLIC_DEMO=false

# NEXT_PUBLIC_SHOW_DEMO_HINTS / Demo 提示 chrome（默认 false）
# CN: 显示种子测试钱包列表、复制按钮等仅供演示的辅助 UI；开发环境自动开启。
# EN: Shows seeded test-wallet lists, copy buttons, and other demo-only helper UI.
#     Defaults false; also treated as on in development.
NEXT_PUBLIC_SHOW_DEMO_HINTS=0
