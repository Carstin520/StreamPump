# =============================================================================
# CN: StreamPump frontend environment example.
# EN: StreamPump frontend environment example.
# =============================================================================

# NEXT_PUBLIC_BACKEND_BASE_URL / 前端访问后端的基准地址
# CN: 这里只填后端源站，不要包含额外路径；前端代码会自行拼接 /api/...。
# EN: Backend origin only. Do not append extra paths; the frontend code appends /api/... itself.
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:4000

# NEXT_PUBLIC_API_BASE_URL / 兼容旧变量名
# CN: 老代码可能仍读取这个完整 API 路径；新配置优先使用 NEXT_PUBLIC_BACKEND_BASE_URL。
# EN: Backward-compatible full API base path. New setups should prefer NEXT_PUBLIC_BACKEND_BASE_URL.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# NEXT_PUBLIC_RPC_ENDPOINT / Solana RPC 地址
# CN: 钱包、只读链上查询和前端签名流都依赖它。
# EN: Used by wallet connections, read-only chain queries, and frontend signing flows.
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# NEXT_IMAGE_REMOTE_HOSTS / Next Image 允许优化的远程图片域名
# CN: 仅填写你控制的公开素材/CDN 域名，逗号分隔；路径在 next.config.js 中限制为 /content/**。
# EN: Comma-separated public media/CDN hosts controlled by this app; next.config.js limits paths to /content/**.
NEXT_IMAGE_REMOTE_HOSTS=dhtrwpa2mlguo.cloudfront.net

# NEXT_PUBLIC_WEB3AUTH_CLIENT_ID / Web3Auth 客户端 ID
# CN: 如果你继续保留 Web3Auth 社交登录，请填写它；否则可以先留空。
# EN: Fill this if you continue using Web3Auth social login; otherwise it can stay empty for now.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# NEXT_PUBLIC_ENABLE_PREVIEW_SOCIAL_AUTH / 预览社交登录开关
# CN: 仅本地/录屏 demo 可设 true；公开预览请保持 false 并使用钱包签名登录。
# EN: Set true only for local/video demos; public previews should keep false and use wallet signature login.
NEXT_PUBLIC_ENABLE_PREVIEW_SOCIAL_AUTH=false
